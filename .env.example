# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 git에 올라가지 않음)

# DB (compose가 만드는 Postgres와 앱이 함께 사용) - 충분히 긴 임의 문자열 권장
DB_PASSWORD=change-me

# JWT 서명 키 - 32자 이상 임의 문자열. 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Google 로그인 (https://console.cloud.google.com/apis/credentials)
# 승인된 리디렉션 URI에 ${APP_BASE_URL}/login/oauth2/code/google 를 등록해야 한다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API 키 (선택, 비우면 AI 추천 기능만 동작 안 함)
GOOGLE_AI_API_KEY=

# 가입을 허용할 이메일 (쉼표 구분, 필수). 여기 없는 이메일은 가입할 수 없다.
# 이메일 가입과 Google 로그인(새 계정 생성) 모두에 적용되고, 이미 가입된 계정의 로그인에는 영향 없음.
ALLOWED_EMAILS=me@example.com,partner@example.com

# 서비스 도메인 (Caddy가 이 도메인으로 HTTPS 인증서를 자동 발급). 예: mygoals.duckdns.org
DOMAIN=goals.example.com

# 서비스에 접속하는 실제 주소 (https, 끝에 / 없이). 보통 https://${DOMAIN}
APP_BASE_URL=https://goals.example.com

# 로컬 호스트에 열 앱 포트 (선택, 기본 8080, 127.0.0.1 에만 바인딩됨)
# APP_PORT=8080
